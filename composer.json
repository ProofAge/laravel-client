{
    "name": "proofage/laravel-client",
    "description": "Laravel client package for ProofAge API with HMAC authentication",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "ProofAge Team",
            "email": "support@proofage.xyz"
        }
    ],
    "support": {
        "docs": "https://docs.proofage.xyz/api-reference.html#/"
    },
    "require": {
        "php": "^8.2",
        "proofage/php-sdk": "^0.2.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/config": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.30",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "ProofAge\\Laravel\\": "src/"
        },
        "files": [
            "src/Support/dump-casters.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ProofAge\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ProofAge\\Laravel\\ProofAgeServiceProvider"
            ],
            "aliases": {
                "ProofAge": "ProofAge\\Laravel\\Facades\\ProofAge"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "check-release": "@php scripts/check-release.php"
    },
    "config": {
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
